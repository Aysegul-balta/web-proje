<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş Yap</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">

    <%- include('partials/header') %>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-4">

                <div class="card shadow p-4" style="border-radius: 20px;">
                    <h2 class="text-center mb-4">Giriş Yap</h2>

                    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
                        <div class="alert alert-danger py-2"><%= error_msg %></div>
                    <% } %>

                    <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
                        <div class="alert alert-success py-2"><%= success_msg %></div>
                    <% } %>

                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control" placeholder="Email" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Şifre</label>
                            <input type="password" name="password" class="form-control" placeholder="Şifre" required>
                        </div>

                        <button type="submit" class="btn btn-success w-100 rounded-pill py-2">
                            Giriş Yap
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <small>Hesabın yok mu? <a href="/register" class="text-success">Kaydol</a></small>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>