<%- include('partials/header') %>

<div class="container mt-5 mb-5">
    <h2 class="mb-4 fw-bold">Sepetim</h2>
    
    <% if (cart && cart.length > 0) { %>
        <div class="table-responsive shadow-sm" style="border-radius: 15px; overflow: hidden;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ürün</th>
                        <th>Fiyat</th>
                        <th class="text-center">Adet</th>
                        <th>Toplam</th>
                    </tr>
                </thead>
                <tbody>
                    <% cart.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 50px; height: 70px; object-fit: contain;" class="me-3">
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= item.name %></h6>
                                        <small class="text-muted"><%= item.author %></small>
                                    </div>
                                </div>
                            </td>
                            <td><%= item.price %> TL</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center">
                                    <form action="/products/cart/decrease/<%= item.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 30px; height: 30px; padding: 0;">-</button>
                                    </form>
                                    
                                    <span class="mx-3 fw-bold"><%= item.quantity %></span>
                                    
                                    <form action="/products/cart/increase/<%= item.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 30px; height: 30px; padding: 0;">+</button>
                                    </form>
                                </div>
                            </td>
                            <td class="fw-bold"><%= (item.price * item.quantity).toFixed(2) %> TL</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="mt-4 text-end">
            <h4 class="fw-bold text-success">Genel Toplam: <%= total.toFixed(2) %> TL</h4>
            <a href="/products" class="btn btn-outline-dark rounded-pill mt-2">← Alışverişe Devam Et</a>
            <button class="btn btn-bookle rounded-pill mt-2 ms-2 px-4 shadow">Ödemeye Geç</button>
        </div>

    <% } else { %>
        <div class="text-center py-5 shadow-sm bg-white" style="border-radius: 20px;">
            <p class="lead text-muted">Sepetiniz şu an boş.</p>
            <a href="/products" class="btn btn-bookle rounded-pill px-4">Kitapları Keşfet</a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>