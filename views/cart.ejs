<%- include('partials/header') %>

<div class="container mt-5 mb-5">
    <h2 class="mb-4 fw-bold">Sepetim</h2>
    
    <% if (cart && cart.length > 0) { %>
        <div class="table-responsive shadow-sm" style="border-radius: 15px; overflow: hidden; background: white;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ürün</th>
                        <th>Fiyat</th>
                        <th class="text-center">Adet</th>
                        <th class="pe-4">Toplam</th>
                    </tr>
                </thead>
                <tbody>
                    <% cart.forEach(item => { %>
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 50px; height: 70px; object-fit: contain;" class="me-3 shadow-sm rounded">
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= item.name %></h6>
                                        <small class="text-muted"><%= item.author %></small>
                                    </div>
                                </div>
                            </td>
                            <td><%= item.price %> TL</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <form action="/products/cart/decrease/<%= item.id %>" method="POST" class="m-0">
                                        <button type="submit" class="cart-qty-btn">-</button>
                                    </form>
                                    
                                    <span class="mx-2 fw-bold" style="min-width: 20px; text-align: center;"><%= item.quantity %></span>
                                    
                                    <form action="/products/cart/increase/<%= item.id %>" method="POST" class="m-0">
                                        <button type="submit" class="cart-qty-btn">+</button>
                                    </form>
                                </div>
                            </td>
                            <td class="fw-bold pe-4 text-success"><%= (item.price * item.quantity).toFixed(2) %> TL</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="mt-4 text-end">
            <h4 class="fw-bold mb-3" style="color: var(--bookle-green);">Genel Toplam: <%= total.toFixed(2) %> TL</h4>
            
            <div class="d-flex justify-content-end align-items-center gap-3">
                <a href="/products/all" class="btn btn-continue-shopping">
                    ← Alışverişe Devam Et
                </a>
                
                <a href="/checkout" class="btn btn-checkout shadow-sm">
                    Ödemeye Geç
                </a>
            </div>
        </div>

    <% } else { %>
        <div class="text-center py-5 shadow-sm bg-white" style="border-radius: 20px;">
            <i class="bi bi-cart-x text-muted display-1 mb-3"></i>
            <p class="lead text-muted">Sepetiniz şu an boş.</p>
            <a href="/products/all" class="btn btn-bookle rounded-pill px-5 mt-2">Kitapları Keşfet</a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>