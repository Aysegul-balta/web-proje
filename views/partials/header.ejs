<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Fontlar -->
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bookle-dark: #1a2b48;
            --bookle-green: #3bb78f;
        }
        body { font-family: 'Jost', sans-serif; background-color: #fff; }
        h1, h2 { font-family: 'Playfair Display', serif; color: var(--bookle-dark); }
        .btn-bookle { background-color: var(--bookle-green); color: white; border-radius: 50px; padding: 12px 35px; border: none; }
        .btn-bookle:hover { background-color: #2ea37d; color: white; }
    </style>
</head>
<body>
<!-- Navigasyon Çubuğu (Bookle Tarzı) -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top py-3">
    <div class="container">
        <!-- Logo Alanı -->
        <a class="navbar-brand d-flex align-items-center" href="/">
            <span class="fs-3 fw-bold" style="color: var(--bookle-dark);">Bookle</span>
        </a>

        <!-- Mobil Menü Butonu -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menü Linkleri -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                <li class="nav-item">
                    <a class="nav-link active fw-medium" href="/">Ana Sayfa</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium" href="/products">Ürünler</a>
                </li>
            </ul>

            <!-- Sağ Taraf: Dinamik Giriş/Çıkış Kontrolü -->
            <div class="d-flex align-items-center">
                <% if (typeof user !== 'undefined' && user) { %>
                    <!-- Kullanıcı Giriş Yapmışsa Burası Görünür -->
                    <span class="me-3 fw-semibold" style="color: var(--bookle-green);">
                        Hoş geldin, <%= user.username %>!
                    </span>
                    <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">Çıkış Yap</a>
                <% } else { %>
                    <!-- Kullanıcı Giriş Yapmamışsa Burası Görünür -->
                    <a href="/login" class="nav-link me-3 fw-medium text-dark">Giriş Yap</a>
                    <a href="/register" class="btn btn-bookle rounded-pill shadow-sm">Kaydol</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>