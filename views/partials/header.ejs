<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookle - Kitap Alışverişi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@400;600&family=Playfair+Display:wght@700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <span class="fs-3 fw-bold" style="color: #1a2b48;">Bookle</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>


        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                <li class="nav-item">
                    <a class="nav-link active fw-medium" href="/">Ana Sayfa</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/products/all">Ürünlerimiz</a>
                </li>
                 <li class="nav-item">
                        <a class="nav-link fw-medium" href="/products/cart">Sepet</a>
                    </li>
            </ul>




                <div class="d-flex align-items-center">
                    <% if (typeof user !=='undefined' && user) { %>
                        <span class="me-3 fw-semibold" style="color: #3bb78f;">
                            Hoş geldin, <%= user.username %>!
                        </span>
                        <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">Çıkış Yap</a>
                        <% } else { %>
                            <a href="/register" class="btn btn-bookle rounded-pill shadow-sm">Giriş Yap & Kaydol</a>
                            <% } %>
                </div>
            </div>
        </div>
    </nav>