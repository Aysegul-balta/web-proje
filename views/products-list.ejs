<%- include('partials/header') %>

<div class="container mt-5">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="m-0 fw-bold">Tüm Kitaplarımız</h2>
        </div>
        <div class="col-md-6">
            <form action="/products/all" method="GET" class="d-flex shadow-sm rounded-pill overflow-hidden bg-white border">
                <input 
                    type="text" 
                    name="search" 
                    class="form-control border-0 ps-4 py-2" 
                    placeholder="Kitap ismi veya yazar ara..." 
                    value="<%= searchQuery || '' %>"
                    style="box-shadow: none;"
                >
                <button type="submit" class="btn btn-white border-0 pe-4">
                    <i class="bi bi-search text-success"></i>
                </button>
            </form>
        </div>
    </div>

    <% if (searchQuery) { %>
        <div class="mb-4">
            <span class="badge bg-light text-dark border p-2 rounded-pill">
                "<strong><%= searchQuery %></strong>" için sonuçlar
                <a href="/products/all" class="ms-2 text-danger text-decoration-none">
                    <i class="bi bi-x-circle-fill"></i>
                </a>
            </span>
        </div>
    <% } %>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        <% if (products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="col">
                    <div class="card h-100 shadow-sm product-card border-0 position-relative">
                        
                        <div class="position-relative">
                            <img src="<%= product.image %>" class="card-img-top p-3" alt="<%= product.name %>" style="height: 250px; object-fit: contain;">
                            
                            <div class="position-absolute top-0 end-0 p-2 d-flex flex-column gap-2" style="z-index: 5;">
                                <button class="btn btn-light btn-sm rounded-circle shadow-sm btn-paylas-mor" 
                                    title="Paylaş" 
                                    onclick="event.stopPropagation(); navigator.clipboard.writeText(window.location.origin + '/products/<%= product.id %>'); alert('Link kopyalandı!')">
                                    <i class="bi bi-share"></i>
                                </button>
                                
                                <button type="button" 
                                    class="btn btn-light btn-sm rounded-circle shadow-sm btn-favori-kirmizi <%= (locals.user && user.favorites && user.favorites.includes(String(product.id))) ? 'active' : '' %>" 
                                    onclick="event.stopPropagation(); handleFavorite('<%= product.id %>', this)"
                                    title="Favorilere Ekle">
                                    <i class="bi <%= (locals.user && user.favorites && user.favorites.includes(String(product.id))) ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                                </button>
                            </div>
                        </div>

                        <div class="card-body text-center">
                            <a href="/products/<%= product.id %>" class="stretched-link"></a>
                            <h5 class="card-title fw-bold text-truncate"><%= product.name %></h5>
                            <p class="card-text text-muted mb-1 small"><%= product.author %></p>
                            <h6 class="text-success fw-bold"><%= product.price %> TL</h6>
                        </div>

                        <div class="card-footer bg-transparent border-0 pb-3" style="z-index: 5;">
                            <form action="/cart/add/<%= product.id %>" method="POST">
                                <button type="submit" class="btn btn-outline-boogle w-100 rounded-pill d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-cart3"></i>
                                    <span class="fw-bold">Sepete Ekle</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <i class="bi bi-emoji-frown text-muted display-1"></i>
                <h4 class="mt-3">Aradığın kitabı bulamadık...</h4>
                <a href="/products/all" class="btn btn-outline-success rounded-pill mt-2">Tüm Ürünleri Gör</a>
            </div>
        <% } %>
    </div>
</div>

<script>
function handleFavorite(productId, button) {
    fetch('/favorite/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: productId })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            location.reload(); 
        } else {
            alert(data.message || "Giriş yapmalısın!");
        }
    })
    .catch(err => console.error("Hata:", err));
}
</script>

<%- include('partials/footer') %>