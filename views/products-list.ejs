<%- include('partials/header') %>

<div class="container mt-5 mb-5">
    <h2 class="mb-4 fw-bold">Tüm Kitaplarımız</h2>
    <div class="row g-4">
        <% products.forEach(product => { %>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0">
                    <img src="<%= product.image %>" class="card-img-top p-3" style="height: 250px; object-fit: contain;">
                    <div class="card-body text-center">
                        <h6 class="fw-bold"><%= product.name %></h6>
                        <p class="text-muted small"><%= product.author %></p>
                        <p class="text-success fw-bold"><%= product.price %> TL</p>
                        <form action="/products/cart/add/<%= product.id %>" method="POST">
                            <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill w-100">Sepete Ekle</button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<%- include('partials/footer') %>