<%- include('partials/header') %>

<section class="hero-section py-5" style="background-color: #eef5f9; border-radius: 0 0 50px 50px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4" style="color: #1a2b48;">Yeni Kitabını <br>En İyi Fiyatla Al</h1>
                <p class="lead mb-5 text-muted">Aradığın tüm klasikler ve yeni çıkanlar Bookle'da seni bekliyor.</p>
                <a href="#kitaplar" class="btn btn-bookle btn-lg shadow">Şimdi Keşfet →</a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://images.unsplash.com/photo-1589998059171-988d887df646?q=80&w=500" class="img-fluid rounded shadow-lg" alt="Kitaplar">
            </div>
        </div>
    </div>
</section>

<div class="container mt-5 mb-5">
    <div class="row text-center mb-5">
        <div class="col">
     <h1 class="fw-bold display-5" style="color: var(--bookle-dark);">
            Bir Sonraki Hikayeni Keşfet
        </h1>
            <p class="lead text-muted">Öne çıkan kitaplarımıza göz atın.</p>
        </div>
    </div>

    <div class="row g-4">
        <% if (products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 15px; overflow: hidden; transition: all 0.3s ease;">
                        
                        <a href="/products/<%= product.id %>" class="text-decoration-none text-dark">
                            <div class="p-4 text-center bg-light">
                                <img src="<%= product.image %>" class="card-img-top" style="height: 220px; object-fit: contain;">
                            </div>
                            <div class="card-body text-center pb-0">
                                <h6 class="fw-bold mb-1"><%= product.name %></h6>
                                <p class="text-muted small mb-2"><%= product.author %></p>
                            </div>
                        </a>

                        <div class="card-body pt-0 text-center d-flex flex-column">
                            <div class="tooltip-demo mb-3">
                                <div class="tip-wrap">
                                    <button class="tip-btn fav-btn" data-tip="Favorilere eklendi ✨" onclick="event.preventDefault(); this.classList.toggle('active')">
                                        ♡ Favorite
                                    </button>
                                </div>
                                <div class="tip-wrap">
                                    <button class="tip-btn tip-btn--alt" data-tip="Arkadaşlarınla paylaş →" onclick="event.preventDefault();">
                                        ↑ Share
                                    </button>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <p class="text-success fw-bold fs-5 mb-3"><%= product.price %> TL</p>
                                <form action="/products/cart/add/<%= product.id %>" method="POST">
                                    <button type="submit" class="btn btn-add-cart w-100 rounded-pill py-2">
                                        <i class="bi bi-cart-plus me-2"></i>Sepete Ekle
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>